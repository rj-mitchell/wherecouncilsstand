# Nightly copy of the one thing that cannot be rebuilt: the state database (spending, saved briefings, reports).
# Installed by deploy/update.sh with councils-backup.timer. Copies land in /opt/wherecouncilsstand/deploy/backups
# (the last 7; the off-site bucket keeps 60). Then the nightly housekeeping (councils tidy): what the privacy page
# says is deleted in time is deleted then, whether or not anyone visits (the record of each briefing after 13
# months, a visitor's code after its day, a statement's confirming address three months after it ends). It runs
# whether or not the backup worked (ExecStopPost), so a failing backup never puts the deleting off; if either
# fails, the alert email is sent.
[Unit]
Description=Where Councils Stand: back up the state database
After=docker.service
Requires=docker.service
# Emails the alerts address if this fails (deploy/alert@.service in Where MPs Stand, docs/HOSTING.md there)
OnFailure=alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/wherecouncilsstand/deploy
ExecStart=/usr/bin/docker compose run --rm -T app councils backup --to /backups --keep 7
ExecStopPost=/usr/bin/docker compose run --rm --no-deps -T app councils tidy
Nice=10
TimeoutStartSec=30min
