# Bring Where Councils Stand's data up to date: new and recently changed meetings from every council's Modern.gov
# site, their named votes, the search index, and up to an hour of meaning search. Installed by deploy/update.sh with
# councils-update.timer (docs/OPERATIONS.md).
[Unit]
Description=Where Councils Stand: update data
After=docker.service
Requires=docker.service
# Emails the alerts address if this fails (deploy/alert@.service in Where They Stand, docs/HOSTING.md there)
OnFailure=alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/wherecouncilsstand/deploy
# Exits 1 when something needs attention; each run's summary is appended to /data/updates.jsonl.
ExecStart=/usr/bin/docker compose run --rm -T app councils update --embed-minutes 60
Nice=10
TimeoutStartSec=4h
