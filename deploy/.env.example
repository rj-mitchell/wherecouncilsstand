# Copy to .env (never commit it) and fill in.

# Anthropic API key for written briefings. Without one the site shows the sources only.
# Spending is capped in config/settings.toml ([usage]).
COUNCILS_ANTHROPIC_API_KEY=

# Off-site copies of the nightly backup (Backblaze B2). The charity's sites share one bucket and key: copy them
# from Where MPs Stand's settings with the command in docs/DEPLOY.md ("Backups"), rather than by hand.
COUNCILS_B2_BUCKET=
COUNCILS_B2_KEY_ID=
COUNCILS_B2_APPLICATION_KEY=

# The family's check token, for the charity's nightly check of every site (wts-core docs/adr/0010): the same random
# value as FAMILY_CHECK_TOKEN in the charity repository's Actions secrets. With it set, /api/check gives whoever
# presents it counts and ages only (reports and statements waiting, the newest backup, how the last day's briefings
# ended), and a question asked with it is written afresh rather than replayed. Left empty, /api/check is not there.
COUNCILS_CHECK_TOKEN=
